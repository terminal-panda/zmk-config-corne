/*
 * Proposed Corne layout tuned for Omarchy (Hyprland).
 *
 * Super lives on the left resting thumb, layers on the inner thumbs, so every
 * Super+<key> chord is split across both hands (or is one-handed on the left,
 * leaving the right hand on the mouse).
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define SYS  3

// App keys on SYM. Spare keycodes that Hyprland binds to launchers
// (~/.config/hypr/bindings.lua); change the app there, not here.
#define APP_LAUNCH   F13
#define APP_TERM     F14
#define APP_GITHUB   F15
#define APP_FILES    F16
#define APP_GROK     F17
#define APP_X        F18
#define APP_T3       F19
#define APP_BROWSER  F24

/ {
        behaviors {
                // Thumb layer-tap: key on tap, layer on hold. Used for
                // Enter/SYM and Space/NAV. require-prior-idle keeps fast
                // typing from ever turning a tap into a layer.
                lt_th: layer_tap_thumb {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <200>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        bindings = <&mo>, <&kp>;
                };
        };

        // Hold SYM + NAV (both inner thumbs) for SYS.
        conditional_layers {
                compatible = "zmk,conditional-layers";
                sys_layer {
                        if-layers = <SYM NAV>;
                        then-layer = <SYS>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                base_layer {
                        display-name = "BASE";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | ESC  |
//                    | ALT | GUI | ENT/SYM |   | SPC/NAV | GUI | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LALT &kp LGUI &lt_th SYM RET   &lt_th NAV SPACE &kp LGUI &kp LALT
                        >;
                };

                sym_layer {
                        display-name = "SYM";
// -----------------------------------------------------------------------------------------
// |      |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | DEL  |
// |      | APPS| TERM| GHUB|FILES| GROK|   |  -  |  =  |  [  |  ]  |  \  |  `   |
// |      |     |  X  |  T3 |     | BRWS|   |  _  |  +  |  {  |  }  |  |  |  ~   |
//                    |     |     | ### |   | SYS |     |     |
                        bindings = <
   &trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp DEL
   &trans &kp APP_LAUNCH &kp APP_TERM &kp APP_GITHUB &kp APP_FILES &kp APP_GROK      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &trans &trans         &kp APP_X    &kp APP_T3     &trans        &kp APP_BROWSER   &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                          &trans   &trans   &trans      &trans    &trans    &trans
                        >;
                };

                nav_layer {
                        display-name = "NAV";
// -----------------------------------------------------------------------------------------
// |      |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | DEL  |
// |      | GUI | ALT | CTRL| SHFT|     |   | LFT | DWN |  UP | RGT |  -  |  =   |
// |      |     |     |     |     | CAPS|   | HOME| PGDN| PGUP| END |     |      |
//                    |     |     | SYS |   | ### |     |     |
                        bindings = <
   &trans &kp N1   &kp N2   &kp N3    &kp N4    &kp N5      &kp N6   &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
   &trans &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &trans      &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp MINUS &kp EQUAL
   &trans &trans   &trans   &trans    &trans    &caps_word  &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans    &trans
                            &trans    &trans    &trans      &trans   &trans    &trans
                        >;
                };

                sys_layer {
                        display-name = "SYS";
// -----------------------------------------------------------------------------------------
// |  F11 |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7 |  F8 |  F9 | F10 | F12  |
// |      | BT1 | BT2 |     |     |     |   | PREV| VOL-| VOL+| NEXT| PLAY| MUTE |
// |      | PRT |A+PRT|G+PRT|     |BTCLR|   | BRI-| BRI+|     |     |     |      |
//                    |     |     | ### |   | ### |     |     |
                        bindings = <
   &kp F11 &kp F1       &kp F2       &kp F3       &kp F4       &kp F5         &kp F6      &kp F7      &kp F8      &kp F9    &kp F10  &kp F12
   &trans  &bt BT_SEL 0 &bt BT_SEL 1 &trans       &trans       &trans         &kp C_PREV  &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &kp C_PP &kp C_MUTE
   &trans  &kp PSCRN    &kp LA(PSCRN) &kp LG(PSCRN) &trans     &bt BT_CLR     &kp C_BRI_DN &kp C_BRI_UP &trans   &trans    &trans   &trans
                                      &trans       &trans       &trans         &trans      &trans      &trans
                        >;
                };
        };
};
